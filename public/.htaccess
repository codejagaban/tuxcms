# Static pages generated by `php artisan site:build` live alongside Laravel's
# front controller. index.html MUST come first: cPanel defaults to index.php,
# which would serve the app instead of the generated homepage.
DirectoryIndex index.html index.php

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Real files and directories (the generated site, its assets, media and the
    # dashboard under /admin) are served directly and never reach PHP.

    # Laravel owns only the API and the health check.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(api|up)(/|$) index.php [L]

    # Everything else on this host is static, so a request matching no real file
    # is simply a missing page. Return a real 404 — which ErrorDocument renders
    # as the generated 404.html — rather than booting PHP to say the same thing.
    # Laravel's own 404 would arrive as a PHP-set status, so ErrorDocument would
    # never fire and visitors would see the framework's error page instead.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ - [L,R=404]
</IfModule>

# The build manifest is internal bookkeeping.
<Files ".site-manifest.json">
    Require all denied
</Files>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Generated HTML must revalidate so a publish is visible immediately.
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
    # Vite output is content-hashed, so it can be cached hard.
    <FilesMatch "\.(css|js|woff2?|avif|webp|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
